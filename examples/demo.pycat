# PyCat Demo - Working Version
Meow("Welcome to PyCat Language!")
Meow("=" * 40)

# ========== VARIABLES ==========
Meow("\n1. Variables:")
name CatGets "Whiskers"
age CatGets 3
weight CatGets 4.2
is_cat CatGets True

Meow(f"Name: {name}")
Meow(f"Age: {age} years")
Meow(f"Weight: {weight} kg")
Meow(f"Is cat? {is_cat}")

# ========== MATH ==========
Meow("\n2. Math Operations:")
a CatGets 10
b CatGets 3

Meow(f"{a} + {b} = {a + b}")
Meow(f"{a} - {b} = {a - b}")
Meow(f"{a} * {b} = {a * b}")
Meow(f"{a} / {b} = {a / b}")
Meow(f"{a} % {b} = {a % b}")

# ========== COMPARISONS ==========
Meow("\n3. Comparisons:")
IfHungry age > 2:
    Meow(f"{name} is older than 2 years")
Otherwise:
    Meow(f"{name} is 2 or younger")

IfHungry name == "Whiskers":
    Meow("This cat is named Whiskers!")
Otherwise:
    Meow("This cat has a different name")

# ========== LOOPS ==========
Meow("\n4. Loops:")
Meow("Counting...")

ForPrey i InLitterbox range(1, 6):
    IfHungry i == 3:
        Meow(f"Found number {i}!")
        Scratch
    Otherwise:
        Meow(f"Looking... {i}")

# ========== FUNCTIONS ==========
Meow("\n5. Functions:")

Defur feed_cat(cat_name, treats):
    Meow(f"Feeding {cat_name} with {treats} treats...")
    total CatGets treats * 2
    Fetch total

treats_given CatGets feed_cat(name, 3)
Meow(f"Total treats: {treats_given}")

# ========== LISTS ==========
Meow("\n6. Lists:")
cat_toys CatGets ["yarn", "laser", "ball", "feather"]
Meow(f"Toys: {cat_toys}")
Meow(f"Number of toys: {len(cat_toys)}")

Meow("Playing with toys:")
ForPrey toy InLitterbox cat_toys:
    Meow(f"  Playing with {toy}...")

# ========== DICTIONARIES ==========
Meow("\n7. Dictionaries:")
cat_info CatGets {
    "name": "Mittens",
    "color": "calico",
    "lives_left": 7
}

Meow(f"Cat info: {cat_info}")
Meow(f"Color: {cat_info['color']}")

# ========== CONDITIONAL LOGIC ==========
Meow("\n8. Complex Logic:")
hungry CatGets True
has_food CatGets False

IfHungry hungry AndCat NotCat has_food:
    Meow("Cat is hungry and has no food!")
ElseIf hungry AndCat has_food:
    Meow("Cat is eating!")
Otherwise:
    Meow("Cat is sleeping...")

# ========== TYPE CONVERSION ==========
Meow("\n9. Type Conversion:")
num_str CatGets "9"
num_int CatGets int(num_str)
num_float CatGets float(num_str)

Meow(f"String '{num_str}' to int: {num_int}")
Meow(f"String '{num_str}' to float: {num_float}")
Meow(f"As string: {str(num_int)} lives")

# ========== WHILE LOOP ==========
Meow("\n10. While Loop:")
counter CatGets 0
Meow("Counting...")

WhileChasing counter < 3:
    Meow(f"  Count #{counter + 1}")
    counter += 1

# ========== FINAL ==========
Meow("\n" + "=" * 40)
Meow("End of PyCat Demo!")
Meow("Thanks for playing with PyCat!")
