# Guess the Number Game
Meow("Guess the Number Game!")
Meow("=" * 40)

score CatGets 0

Defur play_round(round_num):
    Unleash score
    
    Meow(f"\n--- Round {round_num} ---")
    secret CatGets random.randint(1, 10)
    attempts CatGets 0
    max_attempts CatGets 4
    
    Meow("I'm thinking of a number 1-10...")
    
    WhileChasing attempts < max_attempts:
        guess CatGets ToCatYears(Beg(f"Guess {attempts + 1}/{max_attempts}: "))
        
        IfHungry guess < 1 OrCat guess > 10:
            Meow("Please guess 1-10!")
            KeepGoing
        
        attempts PlusGets 1
        
        IfHungry guess == secret:
            Meow(f"Correct! It took {attempts} tries.")
            score PlusGets max_attempts - attempts + 1
            Fetch True
        ElseIf guess < secret:
            Meow("Too low!")
        Otherwise:
            Meow("Too high!")
    
    Meow(f"Out of tries! Number was {secret}")
    Fetch False

ImportCatnip random

round_num CatGets 1
WhileChasing round_num < 4:
    won CatGets play_round(round_num)
    
    IfHungry won:
        play_again CatGets Beg("Play next round? (y/n): ")
        IfHungry play_again.lower() != "y":
            Scratch
    Otherwise:
        play_again CatGets Beg("Try again? (y/n): ")
        IfHungry play_again.lower() == "y":
            KeepGoing
        Otherwise:
            Scratch
    
    round_num PlusGets 1

Meow("\n" + "=" * 40)
Meow(f"Final Score: {score} points")

IfHungry score > 8:
    Meow("Amazing! You're a pro!")
ElseIf score > 4:
    Meow("Good job!")
Else:
    Meow("Better luck next time!")

Meow("\nThanks for playing!")
