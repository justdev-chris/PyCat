# PyCat Calculator
Meow("PyCat Calculator")
Meow("=" * 40)

WhileChasing True:
    Meow("\nOptions:")
    Meow("1. Add (+)")
    Meow("2. Subtract (-)")
    Meow("3. Multiply (*)")
    Meow("4. Divide (/)")
    Meow("5. Exit")
    
    choice CatGets Beg("\nChoose (1-5): ")
    
    IfHungry choice == "5":
        Meow("Goodbye!")
        Scratch
    
    num1 CatGets ToFloatCat(Beg("First number: "))
    num2 CatGets ToFloatCat(Beg("Second number: "))
    
    IfHungry choice == "1":
        result CatGets num1 + num2
        op CatGets "+"
    ElseIf choice == "2":
        result CatGets num1 - num2
        op CatGets "-"
    ElseIf choice == "3":
        result CatGets num1 * num2
        op CatGets "*"
    ElseIf choice == "4":
        IfHungry num2 == 0:
            Meow("Cannot divide by zero!")
            KeepGoing
        result CatGets num1 / num2
        op CatGets "/"
    Otherwise:
        Meow("Invalid choice!")
        KeepGoing
    
    Meow(f"\n{num1} {op} {num2} = {result}")
    Meow("-" * 30)
